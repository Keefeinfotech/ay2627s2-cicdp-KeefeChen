# Environment variables (example)
# Copy to .env and fill in values

PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/auxilia
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Security / session behaviour
# ALLOW_CONCURRENT_SESSIONS=false means a new login signs the older one out.
ALLOW_CONCURRENT_SESSIONS=false
# Set to true when running behind a reverse proxy (Railway, Nginx, Cloudflare).
TRUST_PROXY=false

# Cloudflare Turnstile (CAPTCHA). Keep the secret server-side only.
# CAPTCHA_ENABLED is forced to true in production by the startup check.
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=
# The site key is public and belongs in the frontend build (see frontend).
TURNSTILE_SITE_KEY=

# AI Configuration
# Use AI_PROVIDER=mock for local development (no external calls).
# Use openai-compatible with AI_BASE_URL, AI_API_KEY and AI_MODEL for a real provider.
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MAX_TOKENS=400
AI_TIMEOUT_MS=15000
# AI_RATE_LIMIT_PER_USER caps AI provider calls per user per hour.
# API_RATE_LIMIT_MAX is the baseline cap for all /api routes (per user/IP per 15 min).
AI_RATE_LIMIT_PER_USER=20
API_RATE_LIMIT_MAX=300

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=Auxilia <your-email@gmail.com>

# Frontend URL used for emailed links, such as group invitations.
APP_BASE_URL=http://localhost:8080

# Backend
BACKEND_URL=http://localhost:3000

# 32-byte encryption key, encoded as 64 hexadecimal characters
MFA_ENCRYPTION_KEY=REPLACE_ME

# Optional Render API integration (do not commit real values; use GitHub Secrets/Render env vars)
RENDER_URL=https://api.render.com/v1
RENDER_API_KEY=REPLACE_WITH_RENDER_API_KEY